<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Place XML docs inside the project's bin folder to avoid permission issues -->
    <DocumentationFile>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datos iniciales exportados con el comando de exportación (ver README) -->
    <None Update="Data\seed-data.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
